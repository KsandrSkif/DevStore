{
  "name": "devstore-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devstore-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devstore-db",
          "database_id": "YOUR_DATABASE_ID"
        }
      ]
    }
  }
}